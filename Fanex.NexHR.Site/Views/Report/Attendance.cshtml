@using Fanex.NexHR.Core;
@model Fanex.NexHR.ViewModels.EmployeeAttendanceViewModel
@{
    ViewBag.Title = "Attendance report";
}

@section css{
    @Url.CombresLink("attendancereportcss")
}
@section js{
    @Url.CombresLink("attendancereportjs")
}

@section Breadcrumb {
    <a class="step">Member Request</a> <span class="step">@ViewBag.Title</span>
}

<h2>Attendance report</h2>

<div class="container_24 bunhat">
    @using (Html.BeginGetForm())
    {
        @Html.ValidationSummary(true)
        
        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0">
                    @Labels.DateRange</option>
                <option value="1">
                    @Labels.ToDay</option>
                <option value="2">
                    @Labels.Yesterday</option>
                <option value="3">
                    @Labels.CurrentWeek</option>
                <option value="4">
                    @Labels.LastWeek</option>
                <option value="5">
                    @Labels.CurrentMonth</option>
                <option value="6">
                    @Labels.LastMonth</option>
                <option value="7">
                    @Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        
        <div class="grid_2">
            From date
        </div>
        <div class="grid_6">
            @Html.DatePicker("FromDate", Model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
            @*<input type="text" id="pickdate" />*@
        </div>
        <div class="grid_2">
            To date 
        </div>
        <div class="grid_4">
            @Html.DatePicker("ToDate", Model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        
        <div class="clear"></div>
        <div class="space"></div>
        
        <div class="grid_2">
            @Html.LabelFor(model => model.Type, "Request")
        </div>
        <div class="grid_4">
            @{
        var types = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "All", Value = "0"}, 
                    new SelectListItem() {Text = "Checkin", Value = "1"},
                    new SelectListItem() {Text = "Checkout", Value = "2"},
                    new SelectListItem() {Text = "Late in", Value = "3"},
                    new SelectListItem() {Text = "Early out", Value = "4"},
                    new SelectListItem() {Text = "Not working", Value = "5"},
                };
            }
            @Html.DropDownListFor(model => model.Type, types)
        </div>
        
        <div class="grid_2">
            @Labels.Team
        </div>
        <div class="grid_6">
            <select id="GroupId" multiple="multiple" name="GroupId" title="@Labels.Team">
                @foreach (Team item in ViewBag.Groups)
                { 
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.EmpId)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmpId)
            @Html.ValidationMessageFor(model => model.EmpId)
        </div>
        
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        
        <div class="grid_2">&nbsp</div>
        
        <div class="grid_4">
            @Html.CheckBoxFor(model => model.ExcludeUserDelete)
            <label for="ExcludeUserDelete"> Exclude Users deleted </label>
        </div>
        
        <div class="grid_2">&nbsp</div>
        
        <div class="grid_6">
            <input type="button" value="@Labels.Submit" id="view"/>
            <input type="button" value="Excel" id="btnExcel"/>
        </div>
        <div class="clear"></div>
    }
</div>

<div class="clear"></div>
<div class="space"></div>

<table id="data" class="data persist-area">
    <thead>
        <tr class = "persist-header">
            <th>
                #
            </th>
            <th>
                @Labels.Date
            </th>
            <th>
                @Labels.Code
            </th>
            <th>
                @Labels.Nick
            </th>
            <th>
                @Labels.FullName
            </th>
            <th>
                @Labels.Team
            </th>
            <th>
                @Labels.Shift
            </th>
            <th>
                @Labels.CheckIn
            </th>
            <th>
                @Labels.CheckOut
            </th>
            <th>
                @Labels.TotalHours
            </th>
            <th>
                @Labels.LateIn
            </th>
            <th>
                @Labels.EarlyOut
            </th>
            <th>
                @Labels.Request
            </th>
            <th>
                @Labels.Overtime
            </th>
            <th>
                @Labels.Note
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<script id="itemTemplate" type="text/x-jquery-tmpl">
    <tr {{if LateIn > 30 || EarlyOut > 30}}class="highlight-row"{{/if}}>
        <td>${index()}</td>
        <td class="ddMMyyyy">            
            ${jsonToShortDate(AttendanceDate)}
        </td>
        <td>
            ${Code}
        </td>
        <td title="${FullName}" class="left tooltip">
            ${NickName}
        </td>
        <td class="left">
            ${FullName}
        </td>
        <td class="tooltip" title="${Team}">
            ${TeamCode}
        </td>
        <td class="tooltip" {{if ShiftCode != null}} title="${ExpectedInTime}-${ExpectedOutTime}" {{/if}}>
            ${ShiftCode}
        </td>
        <td>
            {{if ShiftCode != null && InFixed}}${jsonTojsDate(InFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if ShiftCode != null && OutFixed}}${jsonTojsDate(OutFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                ${totalHoursToTime(TotalWorkHours)}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                ${displayMinute(LateIn)}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                ${displayMinute(EarlyOut)}
            {{/if}}
        </td>
        <td>
            {{if RequestList != null > 0}}
                {{each RequestList}}
                    <a href='#' class="tooltip-request req" 
                            data-requesttype="${RequestType.Id}"
                            data-fromdate="${FromDate}"
                            data-todate="${ToDate}" 
                            data-fromshift="${FromShift}"
                            data-toshift="${ToShift}"
                            data-leavetype="${LeaveType}"
                            data-totaldays="${TotalDays}"
                            data-totalmins="${TotalMins}"
                            data-ottype='${OvertimeType.Id}'
                            data-isothours='${IsOvertimeHours}'
                            data-remark='${Remark}'>
                            {{if RequestType.Id == 6}}
                                ${LeaveType}
                            {{else}}
                                ${RequestType.Name}
                            {{/if}}
                        </a> 
                {{/each}}
               
            {{/if}}
        </td>
        <td>
            {{if OvertimeList != null > 0}}
                {{each OvertimeList}}
                    <a href='#' class="tooltip-overtime overtimetype${OvertimeType.Id}"
                        {{if OvertimeFromTime != null}} data-fromtime="${jsonTojsDate(OvertimeFromTime).format('HH:MM')}" {{else}} data-fromtime="N/A" {{/if}}
                        {{if OvertimeToTime != null}} data-totime="${jsonTojsDate(OvertimeToTime).format('HH:MM')}" {{else}} data-totime="N/A" {{/if}}
                        {{if OvertimeTotalHours != null}} data-totalhours="${totalHoursToTime(OvertimeTotalHours)}" {{else}} data-totalhours="N/A" {{/if}}>
                        ${OvertimeName}
                    </a> 
                {{/each}}
            {{/if}}
        </td>
        <td class="left">
            ${Notes}
        </td>
    </tr>
</script>
